FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake g++ make pkg-config librdkafka-dev libsqlite3-dev python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
CMD ["bash", "-lc", "cmake -S . -B build && cmake --build build -j2 && ctest --test-dir build --output-on-failure"]
